DATABASE_URL=sqlite:///./supportops.db
DATABASE_AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
REFUND_HUMAN_REVIEW_THRESHOLD=500

# Retrieval. `local` keeps CI/dev self-contained. `qdrant` requires real embeddings.
KNOWLEDGE_BACKEND=local
KNOWLEDGE_SOURCES_PATH=
EMBEDDING_BACKEND=deterministic
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_TIMEOUT_SECONDS=5
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=supportops_knowledge
QDRANT_TIMEOUT_SECONDS=3
QDRANT_SYNC_ON_START=true
RETRIEVAL_MIN_EVIDENCE_SCORE=0.16
RETRIEVAL_ALLOW_SPARSE_FALLBACK=true

# Reliability. Local is single-process only; Redis coordinates multiple API replicas.
RELIABILITY_BACKEND=local
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_KEY_PREFIX=supportops
RELIABILITY_REQUIRE_STARTUP=true
RELIABILITY_FAIL_CLOSED_MUTATIONS=true
ACTION_CONFIRMATION_TTL_SECONDS=600
ACTION_LOCK_TTL_SECONDS=15
RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_MESSAGE_RATE_LIMIT=30
ACTION_CONFIRMATION_RATE_LIMIT=10
RATE_LIMIT_FAIL_OPEN=true

# Observability. Metrics use bounded labels; OTLP is optional and expects a /v1/traces endpoint.
METRICS_ENABLED=true
TRACING_ENABLED=true
OTEL_SERVICE_NAME=supportops-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORT_TIMEOUT_SECONDS=3

# Explicit local demo settings. Unconfigured applications default to production + JWT.
# Production: APP_ENV=production, AUTH_MODE=jwt, MCP_AUTH_MODE=jwt, SEED_DEMO_DATA=false.
APP_ENV=development
DEV_TENANT_ID=TENANT-DEMO
# Set true ONLY for an explicitly verified synthetic legacy database migration.
LEGACY_DEMO_BACKFILL=false
AUTH_MODE=dev
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_ALGORITHM=RS256

# MCP Streamable HTTP authorization. Set to jwt for bearer-token protected deployment.
MCP_AUTH_MODE=disabled
MCP_ISSUER_URL=
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_REQUIRED_SCOPE=support:read
MCP_WRITE_SCOPE=support:write
MCP_DEV_CUSTOMER_ID=CUST-001
