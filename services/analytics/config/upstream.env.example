DATACOPILOT_ENVIRONMENT=development
DATACOPILOT_DEBUG=true

DATACOPILOT_APP__NAME=DataPilot-AI
DATACOPILOT_APP__API_PREFIX=/api/v1
DATACOPILOT_APP__HOST=0.0.0.0
DATACOPILOT_APP__PORT=8000
DATACOPILOT_APP__CORS_ORIGINS=["http://localhost:8501"]

DATACOPILOT_PATHS__DATA_DIR=data
DATACOPILOT_PATHS__CHROMADB_DIR=data/chromadb
DATACOPILOT_PATHS__UPLOADS_DIR=data/uploads
DATACOPILOT_PATHS__LOGS_DIR=data/logs
DATACOPILOT_PATHS__CACHE_DIR=data/cache
DATACOPILOT_PATHS__EMBEDDINGS_DIR=data/embeddings
DATACOPILOT_PATHS__TEMP_DIR=data/temp
DATACOPILOT_PATHS__MODELS_DIR=models

DATACOPILOT_RUNTIME__API_ONLY=false
DATACOPILOT_RUNTIME__GPU_ENABLED=false
DATACOPILOT_RUNTIME__CPU_ONLY=true

DATACOPILOT_LOGGING__LEVEL=INFO
DATACOPILOT_LOGGING__JSON_ENABLED=true
DATACOPILOT_LOGGING__CONSOLE_ENABLED=true
DATACOPILOT_LOGGING__FILE_ENABLED=true
DATACOPILOT_LOGGING__FILE_PATH=data/logs/datacopilot.log
DATACOPILOT_LOGGING__MAX_BYTES=20971520
DATACOPILOT_LOGGING__BACKUP_COUNT=10
DATACOPILOT_LOGGING__REQUEST_ID_HEADER=x-request-id
DATACOPILOT_LOGGING__TRACE_ID_HEADER=x-trace-id

DATACOPILOT_LLM__DEFAULT_PROVIDER=deepseek
DATACOPILOT_LLM__REQUEST_TIMEOUT_SECONDS=60
DATACOPILOT_LLM__MAX_RETRIES=2
DATACOPILOT_LLM__STREAMING_ENABLED=true
# 多 LLM 智能路由：专业数据工程任务（Text2SQL/SQL审查/数仓设计）→ 本地微调模型，
# 通用需求 → 云端 provider。开启后需同时开启 DATACOPILOT_LOCAL__ENABLED。
DATACOPILOT_LLM__ROUTING_ENABLED=false
DATACOPILOT_LLM__CLOUD_PROVIDER=deepseek
DATACOPILOT_LLM__ROUTING_FALLBACK_TO_CLOUD=true

DATACOPILOT_EMBEDDINGS__DEFAULT_MODEL=BAAI/bge-m3
DATACOPILOT_EMBEDDINGS__BATCH_SIZE=8
DATACOPILOT_EMBEDDINGS__MAX_LENGTH=1024
DATACOPILOT_EMBEDDINGS__DEVICE=auto
DATACOPILOT_EMBEDDINGS__USE_FP16=true
DATACOPILOT_EMBEDDINGS__LAZY_LOAD=true
DATACOPILOT_VECTOR_STORE__MODE=persistent
DATACOPILOT_VECTOR_STORE__HOST=127.0.0.1
DATACOPILOT_VECTOR_STORE__PORT=8000
DATACOPILOT_VECTOR_STORE__SSL=false
DATACOPILOT_RAG__CHUNK_SIZE=1000
DATACOPILOT_RAG__CHUNK_OVERLAP=200
DATACOPILOT_AGENT__MAX_STEPS=8
DATACOPILOT_MEMORY__BACKEND=in_memory
DATACOPILOT_MEMORY__REDIS_URL=redis://127.0.0.1:6379/0
DATACOPILOT_MEMORY__KEY_PREFIX=datacopilot:memory
DATACOPILOT_MEMORY__SESSION_TTL_SECONDS=86400
DATACOPILOT_MEMORY__LONG_TERM_COLLECTION=agent_long_term_memory
DATACOPILOT_MEMORY__LONG_TERM_TOP_K=5
DATACOPILOT_HEALTH__DEPENDENCY_TIMEOUT_SECONDS=3
DATACOPILOT_EMBEDDINGS__CACHE_ENABLED=true

# Optional trusted analytics identity; configure only with your approved issuer.
DATACOPILOT_IDENTITY__ENABLED=false
DATACOPILOT_IDENTITY__ISSUER=https://identity.example.invalid/
DATACOPILOT_IDENTITY__AUDIENCE=datacopilot-api
DATACOPILOT_IDENTITY__JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
DATACOPILOT_IDENTITY__ALLOWED_ALGORITHMS=["RS256"]
DATACOPILOT_IDENTITY__CLOCK_SKEW_SECONDS=30
DATACOPILOT_IDENTITY__MAX_BEARER_TOKEN_BYTES=8192
DATACOPILOT_IDENTITY__JWKS_CACHE_SECONDS=300
DATACOPILOT_IDENTITY__JWKS_TIMEOUT_SECONDS=2
DATACOPILOT_BUSINESS_ANALYTICS__ENABLED=false
DATACOPILOT_BUSINESS_ANALYTICS__TENANT_GRANTS_JSON=[]
DATACOPILOT_BUSINESS_ANALYTICS__TENANT_DELIVERY_DIRECTORIES_JSON={}
DATACOPILOT_EVAL_LIVE_LLM=false

DATACOPILOT_DEEPSEEK__ENABLED=true
DATACOPILOT_DEEPSEEK__API_KEY=
DATACOPILOT_DEEPSEEK__BASE_URL=https://api.deepseek.com/v1
DATACOPILOT_DEEPSEEK__CHAT_MODEL=deepseek-chat
DATACOPILOT_DEEPSEEK__TIMEOUT_SECONDS=60
DATACOPILOT_DEEPSEEK__MAX_RETRIES=2

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2

DATACOPILOT_OPENAI__ENABLED=false
DATACOPILOT_OPENAI__API_KEY=
DATACOPILOT_OPENAI__BASE_URL=https://api.openai.com/v1
DATACOPILOT_OPENAI__CHAT_MODEL=gpt-4.1-mini
DATACOPILOT_OPENAI__TIMEOUT_SECONDS=60
DATACOPILOT_OPENAI__MAX_RETRIES=2

DATACOPILOT_OLLAMA__ENABLED=false
DATACOPILOT_OLLAMA__BASE_URL=http://127.0.0.1:11434
DATACOPILOT_OLLAMA__CHAT_MODEL=qwen3
DATACOPILOT_OLLAMA__TIMEOUT_SECONDS=120
DATACOPILOT_OLLAMA__KEEP_ALIVE=5m

# 本地微调模型（Ollama OpenAI 兼容接口 /v1/chat/completions）
DATACOPILOT_LOCAL__ENABLED=false
DATACOPILOT_LOCAL__BASE_URL=http://127.0.0.1:11434/v1
DATACOPILOT_LOCAL__CHAT_MODEL=datacopilot-qwen3-8b
DATACOPILOT_LOCAL__TIMEOUT_SECONDS=120
DATACOPILOT_LOCAL__MAX_RETRIES=1
# 路由到本地模型的任务类型（默认 text2sql, sql_review, warehouse_design）
DATACOPILOT_LOCAL__ROUTING_TASKS=["text2sql","sql_review","warehouse_design"]
