{
  "version": 1,
  "mode": "offline",
  "authoritative_path_map": "scripts/service_paths.py",
  "services": [
    {
      "role": "Harness",
      "directory": "services/harness",
      "compatibility_identity": "harness",
      "conda_environment": "agentopshub",
      "pythonpath_relative": "backend/src",
      "port": 8010
    },
    {
      "role": "Support",
      "directory": "services/support",
      "compatibility_identity": "supportops",
      "conda_environment": "supportops-ai",
      "pythonpath_relative": ".",
      "port": 8011
    },
    {
      "role": "Analytics",
      "directory": "services/analytics",
      "compatibility_identity": "datacopilot",
      "conda_environment": "datacopilot",
      "pythonpath_relative": ".",
      "port": 8012
    }
  ],
  "note": "Documentation only; never a client authorization/configuration source. CLI, tokens, workflow IDs and wire service identities remain unchanged."
}
