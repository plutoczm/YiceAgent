  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "decision",
          "expected_version"
        ],
        "title": "Approval"
      },
      "AssignTicket": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "kind": {
            "type": "string",
            "const": "assign_ticket",
            "title": "Kind"
          },
          "ticket_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{0,63}$",
            "title": "Ticket Id"
          },
          "assignee_id": {
            "type": "string",
            "enum": [
              "operator-a",
              "operator-b"
            ],
            "title": "Assignee Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "kind",
          "ticket_id",
          "assignee_id"
        ],
        "title": "AssignTicket"
      },
      "CartItem": {
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{0,63}$",
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "CartItem"
      },
      "Confirmation": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "confirm": {
            "type": "boolean",
            "title": "Confirm"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "confirm",
          "expected_version"
        ],
        "title": "Confirmation"
      },
      "CreateTicket": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "kind": {
            "type": "string",
            "const": "create_ticket",
            "title": "Kind"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9-]{0,63}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "kind",
          "message"
        ],
        "title": "CreateTicket"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderAction": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pay",
              "cancel_order",
              "refund"
            ],
            "title": "Kind"
          },
          "order_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{0,63}$",
            "title": "Order Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "kind",
          "order_id"
        ],
        "title": "OrderAction"
      },
      "PersonaSelection": {
        "properties": {
          "persona": {
            "type": "string",
            "enum": [
              "customer-a1",
              "customer-a2",
              "operator-a",
              "customer-b1",
              "customer-b2",
              "operator-b"
            ],
            "title": "Persona"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "persona"
        ],
        "title": "PersonaSelection"
      },
      "PlaceOrder": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "kind": {
            "type": "string",
            "const": "place_order",
            "title": "Kind"
          },
          "order_type": {
            "type": "string",
            "enum": [
              "ecommerce",
              "food"
            ],
            "title": "Order Type"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartItem"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Items"
          },
          "note": {
            "type": "string",
            "maxLength": 200,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "kind",
          "order_type",
          "items"
        ],
        "title": "PlaceOrder"
      },
      "ReplyTicket": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "kind": {
            "type": "string",
            "const": "reply_ticket",
            "title": "Kind"
          },
          "ticket_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{0,63}$",
            "title": "Ticket Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "kind",
          "ticket_id",
          "message"
        ],
        "title": "ReplyTicket"
      },
      "SimulationEvent": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "order_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{0,63}$",
            "title": "Order Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "event": {
            "type": "string",
            "enum": [
              "payment_succeeded",
              "payment_failed",
              "advance",
              "refund_succeeded",
              "refund_failed"
            ],
            "title": "Event"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "order_id",
          "expected_version",
          "event"
        ],
        "title": "SimulationEvent"
      },
      "TransitionTicket": {
        "properties": {
          "client_request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "title": "Client Request Id"
          },
          "kind": {
            "type": "string",
            "const": "transition_ticket",
            "title": "Kind"
          },
          "ticket_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{0,63}$",
            "title": "Ticket Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_customer",
              "resolved",
              "closed",
              "assigned"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "kind",
          "ticket_id",
          "status"
        ],
        "title": "TransitionTicket"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
