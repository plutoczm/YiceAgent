{
  "http_timeout_seconds": 30,
  "mode": "offline",
  "run_record": {
    "$defs": {
      "Error": {
        "description": "Safe error categories without downstream bodies or exception text.",
        "enum": [
          "authorization_denied",
          "domain_rejected",
          "downstream_timeout",
          "downstream_unavailable",
          "invalid_domain_response",
          "internal_error"
        ],
        "title": "Error",
        "type": "string"
      },
      "Status": {
        "description": "Public terminal states of a synchronous run.",
        "enum": [
          "completed",
          "waiting_confirmation",
          "waiting_approval",
          "failed",
          "unknown_outcome"
        ],
        "title": "Status",
        "type": "string"
      },
      "Step": {
        "additionalProperties": false,
        "description": "Actual graph node execution metadata.",
        "properties": {
          "elapsed_ms": {
            "title": "Elapsed Ms",
            "type": "number"
          },
          "name": {
            "enum": [
              "validate",
              "authorize",
              "invoke_domain",
              "format_record"
            ],
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "elapsed_ms"
        ],
        "title": "Step",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Persisted metadata excludes all domain result rows and text.",
    "properties": {
      "domain_refs": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Domain Refs",
        "type": "object"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "mode": {
        "const": "offline",
        "default": "offline",
        "title": "Mode",
        "type": "string"
      },
      "parent_run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Parent Run Id"
      },
      "run_id": {
        "title": "Run Id",
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/Status"
      },
      "steps": {
        "items": {
          "$ref": "#/$defs/Step"
        },
        "title": "Steps",
        "type": "array"
      },
      "workflow_id": {
        "title": "Workflow Id",
        "type": "string"
      }
    },
    "required": [
      "run_id",
      "parent_run_id",
      "workflow_id",
      "status",
      "steps",
      "domain_refs"
    ],
    "title": "RunRecord",
    "type": "object"
  },
  "run_request": {
    "additionalProperties": false,
    "description": "Outer request with optional ownership-checked parent.",
    "properties": {
      "parent_run_id": {
        "anyOf": [
          {
            "pattern": "^[a-f0-9]{32}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Parent Run Id"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      }
    },
    "required": [
      "payload"
    ],
    "title": "RunRequest",
    "type": "object"
  },
  "run_response": {
    "$defs": {
      "ConfirmationResponse": {
        "description": "SupportOps v1 ConfirmationResponse wire contract.",
        "properties": {
          "action_id": {
            "title": "Action Id",
            "type": "string"
          },
          "operation_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operation Status"
          },
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          },
          "status": {
            "$ref": "#/$defs/PendingActionStatus"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "action_id",
          "status",
          "result"
        ],
        "title": "ConfirmationResponse",
        "type": "object"
      },
      "Error": {
        "description": "Safe error categories without downstream bodies or exception text.",
        "enum": [
          "authorization_denied",
          "domain_rejected",
          "downstream_timeout",
          "downstream_unavailable",
          "invalid_domain_response",
          "internal_error"
        ],
        "title": "Error",
        "type": "string"
      },
      "Intent": {
        "description": "SupportOps v1 Intent wire contract.",
        "enum": [
          "knowledge",
          "order_status",
          "refund",
          "return_request",
          "complaint",
          "unknown"
        ],
        "title": "Intent",
        "type": "string"
      },
      "KnowledgeCitation": {
        "description": "SupportOps v1 KnowledgeCitation wire contract.",
        "properties": {
          "chunk_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chunk Id"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "document_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Document Version"
          },
          "score": {
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "snippet": {
            "title": "Snippet",
            "type": "string"
          },
          "source_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Uri"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "snippet",
          "score"
        ],
        "title": "KnowledgeCitation",
        "type": "object"
      },
      "OperationStatus": {
        "description": "SupportOps v1 OperationStatus wire contract.",
        "enum": [
          "pending_confirmation",
          "pending_approval",
          "submitted",
          "cancelled",
          "expired",
          "rejected",
          "invalidated"
        ],
        "title": "OperationStatus",
        "type": "string"
      },
      "OperationView": {
        "description": "Customer-safe business state; no employee identity or internal audit details.",
        "properties": {
          "customer_confirmed": {
            "title": "Customer Confirmed",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "human_approved": {
            "title": "Human Approved",
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/$defs/PendingActionKind"
          },
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "quoted_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quoted Amount"
          },
          "requires_human_approval": {
            "title": "Requires Human Approval",
            "type": "boolean"
          },
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          },
          "snapshot_version": {
            "title": "Snapshot Version",
            "type": "integer"
          },
          "status": {
            "$ref": "#/$defs/OperationStatus"
          },
          "ticket_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticket Id"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "operation_id",
          "kind",
          "order_id",
          "status",
          "version",
          "snapshot_version",
          "quoted_amount",
          "customer_confirmed",
          "requires_human_approval",
          "human_approved",
          "ticket_id",
          "expires_at"
        ],
        "title": "OperationView",
        "type": "object"
      },
      "OrderView": {
        "description": "SupportOps v1 OrderView wire contract.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "refund_status": {
            "title": "Refund Status",
            "type": "string"
          },
          "refundable_amount": {
            "title": "Refundable Amount",
            "type": "number"
          },
          "return_status": {
            "title": "Return Status",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "customer_id",
          "status",
          "amount",
          "refundable_amount",
          "refund_status",
          "return_status"
        ],
        "title": "OrderView",
        "type": "object"
      },
      "PendingActionKind": {
        "description": "SupportOps v1 PendingActionKind wire contract.",
        "enum": [
          "refund",
          "return_request"
        ],
        "title": "PendingActionKind",
        "type": "string"
      },
      "PendingActionStatus": {
        "description": "SupportOps v1 PendingActionStatus wire contract.",
        "enum": [
          "pending",
          "executed",
          "cancelled",
          "expired",
          "pending_approval",
          "rejected",
          "invalidated"
        ],
        "title": "PendingActionStatus",
        "type": "string"
      },
      "Status": {
        "description": "Public terminal states of a synchronous run.",
        "enum": [
          "completed",
          "waiting_confirmation",
          "waiting_approval",
          "failed",
          "unknown_outcome"
        ],
        "title": "Status",
        "type": "string"
      },
      "Step": {
        "additionalProperties": false,
        "description": "Actual graph node execution metadata.",
        "properties": {
          "elapsed_ms": {
            "title": "Elapsed Ms",
            "type": "number"
          },
          "name": {
            "enum": [
              "validate",
              "authorize",
              "invoke_domain",
              "format_record"
            ],
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "elapsed_ms"
        ],
        "title": "Step",
        "type": "object"
      },
      "SupportResponse": {
        "description": "SupportOps v1 SupportResponse wire contract.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/$defs/KnowledgeCitation"
            },
            "title": "Citations",
            "type": "array"
          },
          "handoff": {
            "default": false,
            "title": "Handoff",
            "type": "boolean"
          },
          "intent": {
            "$ref": "#/$defs/Intent"
          },
          "operation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operation Id"
          },
          "operation_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operation Status"
          },
          "pending_action_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pending Action Expires At"
          },
          "pending_action_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pending Action Id"
          },
          "retrieval_degradation_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retrieval Degradation Reason"
          },
          "retrieval_degraded": {
            "default": false,
            "title": "Retrieval Degraded",
            "type": "boolean"
          },
          "safety_labels": {
            "items": {
              "type": "string"
            },
            "title": "Safety Labels",
            "type": "array"
          },
          "ticket_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ticket Id"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "intent",
          "answer"
        ],
        "title": "SupportResponse",
        "type": "object"
      },
      "TicketMessageRole": {
        "description": "SupportOps v1 TicketMessageRole wire contract.",
        "enum": [
          "customer",
          "assistant",
          "agent"
        ],
        "title": "TicketMessageRole",
        "type": "string"
      },
      "TicketMessageView": {
        "description": "SupportOps v1 TicketMessageView wire contract.",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "context": {
            "additionalProperties": true,
            "title": "Context",
            "type": "object"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "sender_id": {
            "title": "Sender Id",
            "type": "string"
          },
          "sender_role": {
            "$ref": "#/$defs/TicketMessageRole"
          },
          "ticket_id": {
            "title": "Ticket Id",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "ticket_id",
          "conversation_id",
          "customer_id",
          "sender_role",
          "sender_id",
          "body",
          "created_at"
        ],
        "title": "TicketMessageView",
        "type": "object"
      },
      "TicketPriority": {
        "description": "SupportOps v1 TicketPriority wire contract.",
        "enum": [
          "urgent",
          "high",
          "normal",
          "low"
        ],
        "title": "TicketPriority",
        "type": "string"
      },
      "TicketStatus": {
        "description": "SupportOps v1 TicketStatus wire contract.",
        "enum": [
          "open",
          "assigned",
          "pending_customer",
          "resolved",
          "closed"
        ],
        "title": "TicketStatus",
        "type": "string"
      },
      "TicketView": {
        "description": "SupportOps v1 TicketView wire contract.",
        "properties": {
          "assignee_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Assignee Id"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "priority": {
            "$ref": "#/$defs/TicketPriority"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "sla_breached": {
            "title": "Sla Breached",
            "type": "boolean"
          },
          "sla_due_at": {
            "format": "date-time",
            "title": "Sla Due At",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/TicketStatus"
          },
          "ticket_id": {
            "title": "Ticket Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "ticket_id",
          "customer_id",
          "conversation_id",
          "reason",
          "status",
          "priority",
          "sla_due_at",
          "sla_breached",
          "created_at",
          "updated_at"
        ],
        "title": "TicketView",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Typed public result; the durable RunRecord deliberately omits it.",
    "properties": {
      "domain_refs": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Domain Refs",
        "type": "object"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "mode": {
        "const": "offline",
        "default": "offline",
        "title": "Mode",
        "type": "string"
      },
      "parent_run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Parent Run Id"
      },
      "result": {
        "anyOf": [
          {
            "$ref": "#/$defs/OrderView"
          },
          {
            "$ref": "#/$defs/OperationView"
          },
          {
            "$ref": "#/$defs/SupportResponse"
          },
          {
            "$ref": "#/$defs/ConfirmationResponse"
          },
          {
            "$ref": "#/$defs/TicketView"
          },
          {
            "$ref": "#/$defs/TicketMessageView"
          },
          {
            "items": {
              "$ref": "#/$defs/TicketView"
            },
            "type": "array"
          },
          {
            "items": {
              "$ref": "#/$defs/TicketMessageView"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Result"
      },
      "run_id": {
        "title": "Run Id",
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/Status"
      },
      "steps": {
        "items": {
          "$ref": "#/$defs/Step"
        },
        "title": "Steps",
        "type": "array"
      },
      "workflow_id": {
        "title": "Workflow Id",
        "type": "string"
      }
    },
    "required": [
      "run_id",
      "parent_run_id",
      "workflow_id",
      "status",
      "steps",
      "domain_refs"
    ],
    "title": "RunResponse",
    "type": "object"
  },
  "run_timeout_seconds": 60,
  "version": "workflowops-service-api-v1-p3",
  "workflows": {
    "support_confirm": {
      "additionalProperties": false,
      "description": "Customer decision; never implied by an operator approval.",
      "properties": {
        "action_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Action Id",
          "type": "string"
        },
        "confirm": {
          "title": "Confirm",
          "type": "boolean"
        }
      },
      "required": [
        "action_id",
        "confirm"
      ],
      "title": "Confirm",
      "type": "object"
    },
    "support_lookup": {
      "additionalProperties": false,
      "description": "Read an owned order or operation.",
      "properties": {
        "kind": {
          "default": "order",
          "enum": [
            "order",
            "operation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Object Id",
          "type": "string"
        }
      },
      "required": [
        "object_id"
      ],
      "title": "Lookup",
      "type": "object"
    },
    "support_message": {
      "additionalProperties": false,
      "description": "Explicit action or ordinary grounded customer message.",
      "properties": {
        "action": {
          "default": "message",
          "enum": [
            "message",
            "refund",
            "handoff"
          ],
          "title": "Action",
          "type": "string"
        },
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "message": {
          "default": "Please arrange human support",
          "maxLength": 8000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "order_id": {
          "anyOf": [
            {
              "pattern": "^ORD-[0-9]{4,12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        }
      },
      "required": [
        "conversation_id"
      ],
      "title": "Message",
      "type": "object"
    },
    "support_review": {
      "additionalProperties": false,
      "description": "Versioned operator decision.",
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "decision",
        "expected_version"
      ],
      "title": "Review",
      "type": "object"
    },
    "ticket_action": {
      "additionalProperties": false,
      "description": "Finite ticket actions with role-dependent routes.",
      "properties": {
        "action": {
          "enum": [
            "list",
            "get",
            "messages",
            "reply",
            "assign",
            "transition",
            "operation"
          ],
          "title": "Action",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
